# ── Meta Marketing API ───────────────────────────────────────────────────────
# System User token with ads_read + read_insights on the ad account.
META_ACCESS_TOKEN=your_meta_system_user_token_here

# Your ad account ID — always in act_XXXXXXXXX format.
META_AD_ACCOUNT_ID=act_XXXXXXXXXXXXXXXXX

# Graph API version (default: v21.0)
GRAPH_API_VERSION=v21.0

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Option A — file path to the service account JSON key (local development):
# GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account-key.json

# Option B — paste the full JSON as a single line (CI / GitHub Actions):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"my-project",...}
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Client tracker sheet ──────────────────────────────────────────────────────
# ID from the sheet URL: docs.google.com/spreadsheets/d/SHEET_ID/edit
CLIENT_SHEET_ID=your_client_sheet_id_here

# Column numbers (B=2, E=5 — change only if client's sheet structure differs)
CLIENT_DATE_COL=2
CLIENT_SPEND_COL=5

# Tab name format — must match exactly (e.g. "June (2026)")
CLIENT_TAB_NAME_FORMAT={month} ({year})

# ── Optional tunables (defaults shown) ───────────────────────────────────────
LOOKBACK_DAYS=3
